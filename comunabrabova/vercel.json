{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/despre-comuna", "dest": "/despre-comuna.html" },
    { "src": "/primaria", "dest": "/primaria.html" },
    { "src": "/primarul", "dest": "/primarul.html" },
    { "src": "/consiliul-local", "dest": "/consiliul-local.html" },
    { "src": "/servicii-publice", "dest": "/servicii-publice.html" },
    { "src": "/transparenta", "dest": "/transparenta.html" },
    { "src": "/anunturi", "dest": "/anunturi.html" },
    { "src": "/contact", "dest": "/contact.html" }
  ]
}
